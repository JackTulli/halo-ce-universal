[Unit]
Description=Halo internet play master server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 /opt/halo-master/halo_master.py --port 27920 --status-file /var/www/html/halo/status.json --state-file /var/lib/halo-master/stats.json
User=www-data
Group=www-data
Restart=always
RestartSec=2
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/www/html/halo
# the lifetime statistics (/var/lib/halo-master), kept across restarts
StateDirectory=halo-master

[Install]
WantedBy=multi-user.target
